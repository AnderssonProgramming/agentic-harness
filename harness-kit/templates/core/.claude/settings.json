{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run format)",
      "Bash(npm run check)",
      "Bash(npm run -s check)",
      "Bash(npm test)",
      "Bash(git status:*)",
      "Bash(git check-ignore:*)",
      "Skill(audit)",
      "Bash(npm run audit:facts)",
      "Bash(npm run audit:validate:*)",
      "Bash(npm run context:profile:*)"
    ],
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./build/**)",
      "Read(./coverage/**)",
      "Read(./**/*.log)",
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Edit(./.github/**)",
      "Bash(git push --force:*)",
      "Bash(git commit --no-verify:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npx:*)"
    ]
  }
}
