{
  "name": "compass",
  "private": true,
  "version": "0.1.0",
  "description": "Conversational onboarding assistant for junior developers.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "engine:check": "node --env-file-if-exists=.env scripts/check-engine.mjs",
    "test": "vitest run",
    "verify:chat": "node scripts/verify-chat.mjs",
    "verify:route": "node scripts/verify-route.mjs",
    "verify:llm": "node scripts/verify-llm.mjs",
    "verify:persistence": "node scripts/verify-persistence.mjs",
    "verify:todos": "node scripts/verify-todos.mjs",
    "verify:prod": "node scripts/verify-prod.mjs",
    "serve:prod": "node scripts/serve-prod.mjs",
    "verify:prod:local": "node scripts/verify-prod-local.mjs",
    "deploy:preview": "netlify deploy --build",
    "deploy:prod": "netlify deploy --build --prod",
    "context:profile": "node scripts/context-profile.mjs",
    "audit:facts": "node scripts/audit-facts.mjs",
    "audit:validate": "node scripts/audit-validate.mjs",
    "release:gate": "node scripts/release-gate.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:deploy": "node scripts/release-deploy.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "netlify-cli": "^27.10.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "productName": "Compass"
}
