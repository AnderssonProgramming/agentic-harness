# Which engine answers: "anthropic" (default) or "ollama".
INFERENCE_ENGINE=anthropic

# Anthropic (default engine). Never commit a real key; put it in .env.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Ollama (local fallback). Requires `ollama serve`.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=phi3

# Added by llm-connect. INFERENCE_ENGINE: anthropic | ollama | mock (no model, for tests).
MOCK_DELAY_MS=25
# B-11: "off" makes the mock behave like an engine without tool calling (no to-do actions).
MOCK_TOOLS=on

# Production (Netlify): this file is for local development only. The Function reads its variables
# from the site's environment, set in the Netlify UI (Site configuration > Environment variables):
#   ANTHROPIC_API_KEY   required, mark it as secret (the default engine is anthropic)
#   INFERENCE_ENGINE    optional, "anthropic" if unset
#   ANTHROPIC_MODEL     optional, claude-sonnet-5 if unset
# Spend backstop: set a monthly spend limit in the Anthropic console. Netlify's free plan has no
# global daily cap; the Function limits each visitor to 6 requests per 3 minutes.
